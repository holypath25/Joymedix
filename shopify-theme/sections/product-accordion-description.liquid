<div class="joy-accordion-section color-{{ section.settings.color_scheme }}">
  <div class="joy-accordion-inner page-width">

    {%- if section.settings.section_title != blank -%}
      <h2 class="joy-accordion-title">{{ section.settings.section_title }}</h2>
    {%- endif -%}

    {%- assign raw_desc = product.description -%}
    {%- assign has_headings = false -%}
    {%- if raw_desc contains '<h2' -%}
      {%- assign has_headings = true -%}
    {%- endif -%}

    {%- if has_headings -%}
      {%- assign parts = raw_desc | split: '<h2' -%}
      {%- for part in parts -%}
        {%- if forloop.first -%}
          {%- if part != blank -%}
            <div class="joy-accordion-intro">{{ part }}</div>
          {%- endif -%}
        {%- else -%}
          {%- assign h2_parts = part | split: '</h2>' -%}
          {%- assign heading_text = h2_parts[0] | split: '>' | last -%}
          {%- assign body_content = h2_parts[1] -%}
          <details class="joy-accordion-item">
            <summary class="joy-accordion-header">
              <span>{{ heading_text }}</span>
              <span class="joy-accordion-icon">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M3 6L8 11L13 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </summary>
            <div class="joy-accordion-body">{{ body_content }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <div class="joy-accordion-plain">{{ raw_desc }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <details class="joy-accordion-item">
        <summary class="joy-accordion-header">
          <span>{{ section.settings.spec_title | default: '제품 사양' }}</span>
          <span class="joy-accordion-icon">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 6L8 11L13 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </summary>
        <div class="joy-accordion-body">
          <table class="joy-spec-table">
            <tbody>
              {%- for block in section.blocks -%}
                {%- if block.type == 'spec_row' -%}
                  <tr {{ block.shopify_attributes }}>
                    <th>{{ block.settings.label }}</th>
                    <td>{{ block.settings.value }}</td>
                  </tr>
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      </details>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
  .joy-accordion-section {
    padding: 40px 0;
  }

  .joy-accordion-inner {
    max-width: 860px;
    margin: 0 auto;
  }

  .joy-accordion-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-foreground);
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--color-foreground);
    letter-spacing: 0.03em;
  }

  .joy-accordion-intro {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-foreground);
    opacity: 0.8;
    margin-bottom: 24px;
  }

  .joy-accordion-plain {
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--color-foreground);
  }

  .joy-accordion-item {
    border-top: 1px solid rgba(0, 0, 0, 0.12);
  }

  .joy-accordion-item:last-child {
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }

  .joy-accordion-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 4px;
    cursor: pointer;
    list-style: none;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-foreground);
    transition: opacity 0.2s;
    user-select: none;
  }

  .joy-accordion-header::-webkit-details-marker {
    display: none;
  }

  .joy-accordion-header:hover {
    opacity: 0.7;
  }

  .joy-accordion-icon {
    flex-shrink: 0;
    transition: transform 0.25s ease;
    display: flex;
    align-items: center;
  }

  .joy-accordion-item[open] .joy-accordion-icon {
    transform: rotate(180deg);
  }

  .joy-accordion-body {
    padding: 4px 4px 24px;
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--color-foreground);
    opacity: 0.82;
  }

  .joy-accordion-body p { margin: 0 0 0.75em; }
  .joy-accordion-body ul,
  .joy-accordion-body ol { padding-left: 1.25em; margin: 0 0 0.75em; }
  .joy-accordion-body li { margin-bottom: 0.35em; }
  .joy-accordion-body img { max-width: 100%; height: auto; border-radius: 6px; margin: 12px 0; }

  .joy-spec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .joy-spec-table th,
  .joy-spec-table td {
    padding: 10px 12px;
    text-align: left;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    vertical-align: top;
  }

  .joy-spec-table th {
    width: 35%;
    font-weight: 500;
    opacity: 0.6;
    white-space: nowrap;
  }

  .joy-spec-table tr:last-child th,
  .joy-spec-table tr:last-child td {
    border-bottom: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "제품 상세 아코디언",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "섹션 제목",
      "default": "제품 상세 정보"
    },
    {
      "type": "text",
      "id": "spec_title",
      "label": "스펙 테이블 제목",
      "default": "제품 사양"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "색상 스킴",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "spec_row",
      "name": "스펙 항목",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "항목명",
          "default": "제조사"
        },
        {
          "type": "text",
          "id": "value",
          "label": "값",
          "default": "-"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "제품 상세 아코디언"
    }
  ]
}
{% endschema %}
